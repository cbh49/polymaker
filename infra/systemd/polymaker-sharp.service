[Unit]
Description=Polymaker MLB/WNBA/NCAAF sharp-money scrape + trade (oneshot)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/polymaker
EnvironmentFile=/etc/polymaker.env
TimeoutStartSec=20min
ExecStart=/usr/bin/docker compose -f /opt/polymaker/infra/docker-compose.yml run --rm sharp
# Pick up a refreshed watch_list.json without waiting for a crash.
ExecStartPost=-/usr/bin/docker restart polymaker-monitor
Nice=5
